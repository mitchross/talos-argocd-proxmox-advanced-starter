// Renovate configuration for the talos-argocd-proxmox-advanced-starter.
//
// Group routine updates by Application; require manual merge after CI.
//
// Companion doc: ../docs/dockerhub-rate-limit-mitigation.md
//   — covers the host_rules JSON pattern, the 200/6h authenticated
//     free-tier ceiling, abortIgnoreStatusCodes, Docker Hub scheduling,
//     and the automergeType: pr rationale.
//
// Also see .claude/rules/always-pin-sha.md — every image ref in this
// repo carries an @sha256:<digest>. Renovate keeps the digest current
// alongside the tag bump in a single PR.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],

  // Cap concurrency. Three PRs at a time across the whole repo is plenty
  // for a homelab; bumping this turns Renovate into a notification
  // firehose during chart-release weeks.
  automerge: false,
  timezone: 'America/Detroit',
  prHourlyLimit: 3,

  // Stable identifier in PR titles + Dependency Dashboard. Default is
  // fine but explicit is better.
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dependency Dashboard',

  enabledManagers: [
    'helm-values',
    'kubernetes',
    'kustomize',
    'argocd',
    'dockerfile',
    'custom.regex',
  ],

  argocd: {
    managerFilePatterns: [
      '/^infrastructure/.+\\.yaml$/',
      '/^my-apps/.+\\.yaml$/',
      '/^monitoring/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/^infrastructure/.+\\.yaml$/',
      '/^my-apps/.+\\.yaml$/',
      '/^monitoring/.+\\.yaml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/^infrastructure/.+/values\\.yaml$/',
      '/^monitoring/.+/values\\.yaml$/',
      '/^my-apps/.+/values\\.yaml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '(^|/)kustomization\\.ya?ml$',
    ],
  },

  packageRules: [
    {
      description: 'Group routine updates weekly per Application; later rules preserve protected groups.',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'weekly {{{replace "^((?:infrastructure/database/[^/]+/[^/]+|(?:my-apps|infrastructure)/[^/]+/[^/]+|monitoring/[^/]+))(?:/.*)?$" "$1" packageFileDir}}} updates',
      // Override inherited monorepo slugs with the rendered Application group name.
      groupSlug: '{{groupName}}',
      schedule: ['* 0-5 * * 1'],
    },
    {
      description: 'Keep infrastructure upgrades separate from routine updates.',
      matchPackageNames: ['cilium', 'longhorn', 'kube-prometheus-stack', 'argo-cd', 'cloudnative-pg', 'ghcr.io/cloudnative-pg/postgresql', 'ghcr.io/siderolabs/installer', 'ghcr.io/siderolabs/kubelet'],
      groupName: 'weekly {{{replace "^((?:infrastructure/database/[^/]+/[^/]+|(?:my-apps|infrastructure)/[^/]+/[^/]+|monitoring/[^/]+))(?:/.*)?$" "$1" packageFileDir}}} {{depName}} updates',
      groupSlug: '{{groupName}}',
    },
    // ─────────────────────────────────────────────────────────────────
    // Require manual merge for every update type.
    // ─────────────────────────────────────────────────────────────────
    {
      description: 'Review minor and patch updates after CI.',
      matchUpdateTypes: ['minor', 'patch'],
      matchManagers: [
        'helm-values',
        'kubernetes',
        'kustomize',
        'argocd',
      ],
      automerge: false,
      automergeType: 'pr',
    },
    {
      description: 'Major bumps require human review — open the PR immediately so it shows up in the dashboard.',
      matchUpdateTypes: ['major'],
      matchManagers: [
        'helm-values',
        'kubernetes',
        'kustomize',
        'argocd',
      ],
      automerge: false,
      prCreation: 'immediate',
    },

    // ─────────────────────────────────────────────────────────────────
    // No major auto-merge for critical infrastructure charts.
    // 2026-04-08 incident on the source cluster: a kube-prometheus-stack
    // v82→v83 auto-merge caused a full cluster outage via Kyverno
    // webhook deadlock. Pinning these to minor/patch only is non-
    // negotiable. The CLAUDE.md DON'T list mirrors this rule.
    // ─────────────────────────────────────────────────────────────────
    {
      description: 'No major auto-merge for kube-prometheus-stack — historic outage trigger.',
      matchPackageNames: ['kube-prometheus-stack'],
      matchUpdateTypes: ['major'],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'No major auto-merge for longhorn — storage layer, manual review every time.',
      matchPackageNames: ['longhorn'],
      matchUpdateTypes: ['major'],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'No major auto-merge for cilium — CNI, kernel-adjacent, manual review every time.',
      matchPackageNames: ['cilium'],
      matchUpdateTypes: ['major'],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'CNPG postgres image — minor/patch + digest only. Major postgres bump triggers pg_upgrade and is human-only.',
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'CNPG Postgres image updates require manual review; the custom manager reads spec.imageName.',
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: false,
      automergeType: 'pr',
    },

    // ─────────────────────────────────────────────────────────────────
    // Container digest updates. Enabled because every image ref in this
    // repo carries an @sha256:<digest> (always-pin-sha rule). Renovate
    // bumps the tag and the digest together in one PR.
    // ─────────────────────────────────────────────────────────────────
    {
      description: 'Enable container digest updates — paired with always-pin-sha rule.',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['digest'],
      enabled: true,
    },

    {
      description: 'Docker Hub updates join the weekly batch.',
      matchDatasources: ['docker'],
      matchPackageNames: [
        '/^docker\\.io\\//',
        // Bare names like "busybox", "nginx", "redis" — Renovate routes
        // these to docker.io by default.
        '/^[a-z0-9_-]+(\\/[a-z0-9_-]+)?$/',
      ],
      schedule: ['* 0-5 * * 1'],
    },
    {
      description: 'Review major upgrades separately from routine updates and each other.',
      matchUpdateTypes: ['major'],
      groupName: null,
      groupSlug: null,
      automerge: false,
    },
  ],

  // ─────────────────────────────────────────────────────────────────
  // hostRules — Docker Hub PAT (commented stub)
  // ─────────────────────────────────────────────────────────────────
  // Uncomment + populate to authenticate with Docker Hub and unlock the
  // 200 pulls / 6h authenticated rate limit (anonymous = 100 / 6h).
  // Requires a Docker Hub Personal Access Token (free) stored as a
  // GitHub Actions secret named DOCKERHUB_PAT.
  //
  // hostRules: [
  //   {
  //     hostType: 'docker',
  //     matchHost: 'docker.io',
  //     username: 'YOUR_DOCKERHUB_USERNAME',
  //     password: '{{ secrets.DOCKERHUB_PAT }}',
  //   },
  // ],

  // ─────────────────────────────────────────────────────────────────
  // STUB: in-cluster registry pagination workaround.
  //
  // If you run an in-cluster Gitea/Harbor/Forgejo registry that caps
  // the docker registry tag pagination at n=1000 (Renovate's default
  // is n=10000 → PAGINATION_NUMBER_INVALID), uncomment + adapt the
  // customDatasources/customManagers blocks below. The pattern routes
  // image lookups through a JSONata-coerced /v2/.../tags/list endpoint
  // with n=1000.
  //
  // The kubernetes manager STILL extracts the deps from the YAML; the
  // packageRule mutes the kubernetes-manager copy so you only get
  // one PR per bump (the customManager + custom.<your-registry>
  // datasource is the canonical path).
  //
  // customDatasources: {
  //   'your-registry': {
  //     defaultRegistryUrlTemplate: 'https://registry.example.com/v2/{{packageName}}/tags/list?n=1000',
  //     format: 'json',
  //     // Coerce single-tag results into a 1-element array (Zod
  //     // expects array, JSONata returns object on single value).
  //     transformTemplates: [
  //       '{ "releases": [tags.{ "version": $ }] }',
  //     ],
  //   },
  // },
  // customManagers: [
  //   {
  //     description: 'in-cluster registry images — route through custom.your-registry to bypass pagination mismatch.',
  //     customType: 'regex',
  //     managerFilePatterns: [
  //       '/^my-apps/.+\\.yaml$/',
  //     ],
  //     matchStrings: [
  //       'image:\\s*registry\\.example\\.com/(?<packageName>[\\w._-]+):(?<currentValue>v[\\w.-]+)',
  //     ],
  //     depNameTemplate: 'registry.example.com/{{packageName}}',
  //     datasourceTemplate: 'custom.your-registry',
  //     versioningTemplate: 'semver-coerced',
  //   },
  // ],
  // (and a packageRule with `enabled: false` for matchManagers:
  // ['kubernetes'] + matchPackageNames: ['/^registry\\.example\\.com//']
  // to avoid duplicate PRs.)

  ignorePaths: [
    // Helm chart caches inside infrastructure/**/charts/** are
    // managed by `helm dependency update`, not Renovate.
    '**/charts/**',
  ],

  customManagers: [
    {
      description: 'Omni cluster template - Talos version (regex extract)',
      customType: 'regex',
      managerFilePatterns: [
        '/^omni/cluster-template/cluster-template\\.yaml$/',
      ],
      matchStrings: [
        'talos:\\s*\\n\\s+version:\\s*(?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'ghcr.io/siderolabs/installer',
      datasourceTemplate: 'docker',
    },
    {
      description: 'Omni cluster template - Kubernetes version (regex extract)',
      customType: 'regex',
      managerFilePatterns: [
        '/^omni/cluster-template/cluster-template\\.yaml$/',
      ],
      matchStrings: [
        'kubernetes:\\s*\\n\\s+version:\\s*(?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'ghcr.io/siderolabs/kubelet',
      datasourceTemplate: 'docker',
    },

    // ─────────────────────────────────────────────────────────────────
    // CNPG Cluster CRD — image lives in `spec.imageName`, not the
    // standard k8s `image:` field. The default `kubernetes` manager
    // pattern keys on `image:` lines and silently skips imageName, so
    // the CNPG Cluster manifest would never get a Renovate
    // PR for postgresql tag/digest bumps without this customManager.
    //
    // Pattern matches:
    //   imageName: ghcr.io/cloudnative-pg/postgresql:17.6@sha256:abcd...
    // and feeds tag + digest to the docker datasource. Update PRs are
    // gated to minor/patch + digest by the package rule below
    // (cloudnative-pg ships a major every couple years; major
    // postgres bumps require human review of pg_upgrade implications).
    // ─────────────────────────────────────────────────────────────────
    {
      description: 'CNPG postgresql image (spec.imageName, not standard image:)',
      customType: 'regex',
      managerFilePatterns: [
        '/^my-apps/.+/cluster\\.yaml$/',
        '/^infrastructure/.+/cluster\\.yaml$/',
      ],
      matchStrings: [
        'imageName:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^@\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
