# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Helm
charts/*/charts/
charts/*.tgz
# Kustomize-helm chart cache — kustomize pulls these into a sibling
# `charts/` directory next to any kustomization.yaml that has a
# `helmCharts:` block when rendered locally with `--enable-helm`.
# Never commit; ArgoCD pulls fresh on its own. Same convention as the
# source cluster's .gitignore.
**/charts/

# Kustomize cache
kustomize-build-output.yaml

# Secrets that should never be committed
*.key
*.pem
secrets-decrypted/
.env
.env.local

# Talos / Omni runtime
talosconfig
omniconfig
kubeconfig
*-kubeconfig
talos-bootstrap-state/

# Generated by adapt-to-your-cluster.sh
.adapted

# Architect's working notes for the source-cluster-comparison.md final
# deliverable. Quick rationale-capture as each phase lands; not committed.
.compare-notes.md

# Private recording scripts and production notes
/video-notes/

# Test artifacts
*.test
coverage.out
