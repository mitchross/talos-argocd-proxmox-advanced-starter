# ==============================================================================
# PROXMOX INFRASTRUCTURE PROVIDER CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control - it contains secrets.

# ==============================================================================
# REQUIRED: Omni Configuration
# ==============================================================================

# Your Omni instance API endpoint. Trailing slash is required.
OMNI_API_ENDPOINT=https://omni.__REPLACE_ME_DOMAIN__/

# Infrastructure Provider Key (generated in the Omni UI):
#   Settings → Infrastructure Providers → Create Provider
# IMPORTANT: This is an *Infrastructure Provider Key*, NOT a service account key.
OMNI_INFRA_PROVIDER_KEY=your-infra-provider-key-here

# ==============================================================================
# NOTES
# ==============================================================================
# - Proxmox credentials live in config.yaml (next to this file).
# - Make sure to copy config.yaml.example → config.yaml before `docker compose up`.
# - chmod 600 .env after filling it in.
